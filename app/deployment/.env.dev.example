IMAGE_TAG=0.1.0
APP_ENV=development
ALLOWED_ORIGINS=["https://drafts-dev.handsfree.vc"]
PUBLIC_EDITOR_URL=https://drafts-dev.handsfree.vc
GOOGLE_CLIENT_ID=replace-with-development-registration-client-id
GOOGLE_CLIENT_SECRET=replace-with-development-registration-secret
GOOGLE_REDIRECT_URI=https://drafts-api-dev.handsfree.vc/auth/callback/google
HTTP_PORT=18081
DATA_DIRECTORY=/rnotes/RUNNING_DRAFTS_BACKEND/data-dev
BACKUP_DIRECTORY=/rnotes/RUNNING_DRAFTS_BACKEND/backups-dev
DOWNLOAD_STAGING_HOST_DIRECTORY=/rnotes/tmp
DATABASE_MIN_FREE_BYTES=10737418240
DOWNLOAD_STAGING_DIRECTORY=/staging
STAGING_MIN_FREE_BYTES=10737418240
MAX_TRANSPORT_FRAME_BYTES=2097152
ACCOUNT_REQUESTS_PER_MINUTE=30
ACCOUNT_REQUEST_BURST=15
PROCESS_REQUESTS_PER_MINUTE=600
PROCESS_REQUEST_BURST=60
MAX_ACCOUNT_CONCURRENT_FRAME_UPLOADS=2
MAX_PROCESS_CONCURRENT_FRAME_UPLOADS=16
