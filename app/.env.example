APP_ENV=development
AUTH_MODE=basic
ALLOWED_ORIGINS=["http://localhost:5173"]
BASIC_AUTH_USERNAMES=["developer"]
BASIC_AUTH_PASSWORD=replace-with-a-development-password
# For direct Google login, use AUTH_MODE=oidc and configure:
# PUBLIC_EDITOR_URL=http://localhost:5173
# GOOGLE_CLIENT_ID=replace-with-development-registration-client-id
# GOOGLE_CLIENT_SECRET=replace-with-development-registration-secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback/google
# SESSION_COOKIE_SECURE=false
# DATABASE_BUSY_TIMEOUT_MS=5000
# MAX_TRANSPORT_FRAME_BYTES=2097152
# MAX_STAGED_DOWNLOAD_FILES=20
# API_PORT=8000
